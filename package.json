{
  "name": "nexo-device-care",
  "version": "0.1.7",
  "private": true,
  "description": "Nexo device care desktop app",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:sensors": "dotnet publish sensor-host/Nexo.SensorHost.csproj -c Release -r win-x64 --self-contained true -o sensor-host/publish",
    "build:visual-installer": "node installer-launcher/scripts/prepare.cjs && electron-builder --projectDir installer-launcher --win portable --publish never",
    "dist": "npm run build:sensors && electron-builder --win nsis && npm run build:visual-installer",
    "release": "npm run build:sensors && electron-builder --win nsis --publish always && npm run build:visual-installer"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Samuklvm/Project-Nexo.git"
  },
  "devDependencies": {
    "electron": "37.2.0",
    "electron-builder": "26.0.12"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "build": {
    "appId": "com.samuklvm.nexo",
    "productName": "Nexo Device Care",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "main.cjs",
      "preload.cjs",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "sensor-host/publish",
        "to": "sensor-host",
        "filter": ["**/*"]
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Nexo-Setup-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "installer/AVISOS.txt",
      "displayLanguageSelector": true,
      "installerLanguages": ["pt_BR", "en_US"],
      "language": "1046",
      "installerSidebar": "installer/installer-sidebar.bmp",
      "uninstallerSidebar": "installer/installer-sidebar.bmp",
      "include": "installer/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "Samuklvm",
      "repo": "Project-Nexo",
      "releaseType": "release"
    }
  }
}
