{
  "name": "nexo-device-care",
  "version": "0.1.5",
  "private": true,
  "description": "Nexo device care desktop app",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Samuklvm/Project-Nexo.git"
  },
  "devDependencies": {
    "electron": "37.2.0",
    "electron-builder": "26.0.12"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "build": {
    "appId": "com.samuklvm.nexo",
    "productName": "Nexo Device Care",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "main.cjs",
      "preload.cjs",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Nexo-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "installer/AVISOS.txt",
      "displayLanguageSelector": true,
      "installerLanguages": ["pt_BR", "en_US"],
      "language": "1046",
      "installerSidebar": "installer/installer-sidebar.bmp",
      "uninstallerSidebar": "installer/installer-sidebar.bmp",
      "include": "installer/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "Samuklvm",
      "repo": "Project-Nexo",
      "releaseType": "release"
    }
  }
}
