{
  "name": "nexo-device-care",
  "version": "0.11.0",
  "private": true,
  "description": "Nexo Device Care: cuidado e otimização do seu PC (Windows e Linux), com análise local que aprende a sua rotina",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:sensors": "dotnet publish sensor-host/Nexo.SensorHost.csproj -c Release -r win-x64 --self-contained true -o sensor-host/publish",
    "dist": "npm run build:sensors && electron-builder --win nsis",
    "release": "npm run build:sensors && electron-builder --win nsis --publish always",
    "test": "node --test tests/brain.test.cjs tests/main-ipc.test.cjs tests/catalog-journal-experiment.test.cjs tests/session-fps.test.cjs tests/probe-fps-runner.test.cjs tests/lab.test.cjs tests/lab-system.test.cjs tests/library-account.test.cjs tests/connections.test.cjs tests/linux.test.cjs tests/release-notes.test.cjs tests/sensor-service.test.cjs tests/syntax.test.cjs tests/system-scan.test.cjs tests/reboot-test.test.cjs tests/fuzz.test.cjs tests/error-log.test.cjs tests/server.test.cjs tests/cloud.test.cjs tests/features.test.cjs tests/telemetry.test.cjs tests/steam-login.test.cjs tests/net-doctor.test.cjs tests/monitoring.test.cjs",
    "preview": "node dev/build-preview.cjs",
    "build:launcher": "npm --prefix installer-launcher install && npm --prefix installer-launcher run dist",
    "presentmon:hash": "node scripts/fetch-presentmon.cjs --print-hash",
    "presentmon:fetch": "node scripts/fetch-presentmon.cjs",
    "dist:linux": "electron-builder --linux AppImage deb",
    "release:linux": "electron-builder --linux AppImage deb --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Samuklvm/Project-Nexo.git"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "build": {
    "appId": "com.samuklvm.nexo",
    "productName": "Nexo Device Care",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "style.css",
      "theme.css",
      "app.js",
      "main.cjs",
      "preload.cjs",
      "package.json",
      "src/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "third-party/bin",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "config",
        "to": "config",
        "filter": [
          "google-oauth.json",
          "integrations.json",
          "server.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nexo-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "sensor-host/publish",
          "to": "sensor-host",
          "filter": [
            "**/*"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "installer/AVISOS.txt",
      "displayLanguageSelector": true,
      "installerLanguages": [
        "pt_BR",
        "en_US"
      ],
      "language": "1046",
      "installerSidebar": "installer/installer-sidebar.bmp",
      "uninstallerSidebar": "installer/uninstaller-sidebar.bmp",
      "include": "installer/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Samuklvm",
      "repo": "Project-Nexo",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "synopsis": "Cuidado e otimização do PC, com análise local",
      "artifactName": "Nexo-${version}-${arch}.${ext}",
      "executableName": "nexo-device-care",
      "maintainer": "Samuklvm (https://github.com/Samuklvm)",
      "desktop": {
        "entry": {
          "Name": "Nexo Device Care",
          "Comment": "Cuidado e otimização do PC",
          "Keywords": "otimização;desempenho;jogos;sensores;"
        }
      }
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3",
        "x11-utils"
      ],
      "recommends": [
        "power-profiles-daemon",
        "mangohud",
        "policykit-1",
        "lm-sensors"
      ]
    }
  },
  "author": "Samuklvm",
  "homepage": "https://github.com/Samuklvm/Project-Nexo",
  "license": "SEE LICENSE IN LICENSE"
}
