{
  "name": "nexo-device-care",
  "version": "0.2.0",
  "private": true,
  "description": "Nexo Device Care: cuidado e otimização do seu PC, com análise local que aprende a sua rotina",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:sensors": "dotnet publish sensor-host/Nexo.SensorHost.csproj -c Release -r win-x64 --self-contained true -o sensor-host/publish",
    "dist": "npm run build:sensors && electron-builder --win nsis",
    "release": "npm run build:sensors && electron-builder --win nsis --publish always",
    "test": "node --test tests/brain.test.cjs tests/main-ipc.test.cjs",
    "preview": "node dev/build-preview.cjs",
    "build:launcher": "npm --prefix installer-launcher install && npm --prefix installer-launcher run dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Samuklvm/Project-Nexo.git"
  },
  "devDependencies": {
    "electron": "37.2.0",
    "electron-builder": "26.0.12"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "build": {
    "appId": "com.samuklvm.nexo",
    "productName": "Nexo Device Care",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "main.cjs",
      "preload.cjs",
      "package.json",
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "sensor-host/publish",
        "to": "sensor-host",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nexo-Setup-${version}.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "installer/AVISOS.txt",
      "displayLanguageSelector": true,
      "installerLanguages": [
        "pt_BR",
        "en_US"
      ],
      "language": "1046",
      "installerSidebar": "installer/installer-sidebar.bmp",
      "uninstallerSidebar": "installer/uninstaller-sidebar.bmp",
      "include": "installer/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Samuklvm",
      "repo": "Project-Nexo",
      "releaseType": "release"
    }
  }
}
