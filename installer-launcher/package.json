{
  "name": "nexo-installer-launcher",
  "version": "0.11.2",
  "private": true,
  "description": "Instalador visual do Nexo Device Care",
  "main": "main.cjs",
  "scripts": {
    "start": "node scripts/prepare.cjs && electron .",
    "dist": "node scripts/prepare.cjs && electron-builder --win portable --publish never"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "http-cache-semantics": "^4.3.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.samuklvm.nexo.installer",
    "productName": "Nexo Instalador",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "renderer.js",
      "main.cjs",
      "preload.cjs",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nexo-Instalador-${version}.${ext}"
    }
  }
}
